# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Instance folder
instance/
# Flutter build artifacts
mobile_app/build/
mobile_app/.gradle/
mobile_app/*.log
*.log

# Release signing secrets (never commit)
mobile_app/android/key.properties
mobile_app/android/la-maliva-release.jks

# PyInstaller build artifacts (never commit)
/build/
/dist/
*.spec

# Oversized v2.3.8 binary bundle — single 210 MB zip exceeds GitHub's
# 100 MB per-file limit, so it can never be pushed (local use only).
static/releases/La-Maliva-Vista-Setup-v2.3.8-windows.zip
static/releases/la-maliva-vista-v2.3.8.apk
# App binaries ship via GitHub Releases, never git: every committed APK/ZIP
# (~55-70 MB each) is cloned on every Render deploy and blew past the
# free-tier size limits. The site falls back to Release assets automatically.
static/releases/*.apk
static/releases/*.zip
static/releases/*.exe
!static/releases/.gitkeep
